{
  "functions": {
    "my-project1/api/apple2k26/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/my-project1/api/apple2k26/index.php"
    },
    {
      "source": "/(.*)",
      "destination": "/my-project1/api/apple2k26/$1"
    }
  ]
}
